---
import Layout from "../layouts/Layout.astro";

const highlights = [
  {
    title: "Premium cultivation",
    description: "Discover carefully curated cannabis genetics and transparent growing practices.",
  },
  {
    title: "Trusted quality",
    description: "Every batch is selected with consistency, compliance, and customer confidence in mind.",
  },
  {
    title: "Fast updates",
    description: "Share product drops, launch campaigns, and store details from a lightweight content-friendly site.",
  },
] as const;
---

<Layout
  title="Cannabicum | Modern cannabis landing page"
  description="Cannabicum is a clean, modern landing page for showcasing premium cannabis products and brand values."
>
  <main class="page">
    <section class="hero">
      <p class="eyebrow">Cannabicum</p>
      <h1>Grow your brand with a polished cannabis landing page.</h1>
      <p class="intro">
        A simple Astro + TypeScript site built for speed, clarity, and a confident first impression.
      </p>
      <div class="actions">
        <a class="primary" href="mailto:hello@cannabicum.com">Contact sales</a>
        <a class="secondary" href="#highlights">Explore features</a>
      </div>
    </section>

    <section class="card-grid" id="highlights" aria-label="Key highlights">
      {
        highlights.map((highlight) => (
          <article class="card">
            <h2>{highlight.title}</h2>
            <p>{highlight.description}</p>
          </article>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  :global(:root) {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #f4f1e8;
    color: #142013;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(82, 136, 82, 0.2), transparent 30%),
      linear-gradient(180deg, #f9f7f0 0%, #f1edde 100%);
  }

  .page {
    margin: 0 auto;
    max-width: 72rem;
    padding: 4rem 1.5rem 5rem;
  }

  .hero {
    padding: 4rem 0 3rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #3a6b3f;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.95;
  }

  .intro {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #314130;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .actions a {
    border-radius: 999px;
    padding: 0.9rem 1.4rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: #2b5b31;
    color: #f8f6ef;
  }

  .secondary {
    border: 1px solid rgba(20, 32, 19, 0.15);
    color: #142013;
    background: rgba(255, 255, 255, 0.75);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.5rem;
    border: 1px solid rgba(20, 32, 19, 0.12);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 20px 60px rgba(20, 32, 19, 0.06);
  }

  .card h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .card p {
    margin: 0;
    color: #314130;
    line-height: 1.6;
  }

  @media (max-width: 40rem) {
    .page {
      padding-top: 2rem;
    }

    .hero {
      padding-top: 2rem;
    }
  }
</style>
